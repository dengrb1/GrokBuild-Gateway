{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrokBuild Gateway",
  "version": "1.1.0",
  "identifier": "com.gbg.desktop",
  "build": {
    "frontendDist": "../desktop",
    "devUrl": "http://127.0.0.1:8787"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GrokBuild Gateway",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
